#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export FILEBLADE_TEST_STRICT="${FILEBLADE_TEST_STRICT:-1}"
gate_state=$(mktemp -d "${TMPDIR:-/tmp}/fileblade-tests.XXXXXX")
trap 'rm -rf -- "$gate_state"' EXIT
export XDG_STATE_HOME="$gate_state"
PYTHONDONTWRITEBYTECODE=1 python3 tests/test_version_hook.py
cargo_flags=(--workspace --all-targets --locked)
if [[ "${FILEBLADE_OFFLINE:-0}" == "1" ]]; then
  cargo_flags+=(--offline)
else
  cargo fetch --locked
fi
cargo fmt --all -- --check
cargo check "${cargo_flags[@]}"
cargo clippy "${cargo_flags[@]}" -- -D warnings
cargo test "${cargo_flags[@]}"
mapfile -t qml_sources < <(find . \( -path './.git' -o -path './target' -o -path './.*' \) -prune -o -type f \( -name '*.qml' -o -name '*.js' \) -print | sort)
linter=""
for candidate in /usr/lib/qt6/bin/qmllint /usr/lib64/qt6/bin/qmllint qmllint-qt6 qmllint; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" --version 2>/dev/null | grep -q ' 6\.'; then linter=$(command -v "$candidate"); break; fi
done
if [[ -z "$linter" ]]; then
  printf '%s\n' 'Qt 6 qmllint not found; install qt6-declarative' >&2
  exit 1
fi
"$linter" --import disable --unqualified disable "${qml_sources[@]}"
runner="${FILEBLADE_QMLTESTRUNNER:-}"
if [[ -z "$runner" ]]; then
  for candidate in /usr/lib/qt6/bin/qmltestrunner /usr/lib64/qt6/bin/qmltestrunner qmltestrunner-qt6; do
    if command -v "$candidate" >/dev/null 2>&1; then runner=$(command -v "$candidate"); break; fi
  done
fi
if [[ -z "$runner" ]]; then
  printf '%s\n' 'qmltestrunner not found; install qt6-declarative' >&2
  exit 1
fi
if [[ ! -x "$runner" ]]; then
  printf '%s\n' "qmltestrunner is not executable: $runner" >&2
  exit 1
fi
for suite in tests/qml/tst_*.qml; do
  if output=$(env -u QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM=offscreen QT_STYLE_OVERRIDE=Basic \
    "$runner" -platform offscreen -import tests/imports -input "$suite" 2>&1); then
    status=0
  else
    status=$?
  fi
  printf '%s\n' "$output"
  if ((status != 0)) \
    || ! grep -Eq 'Config: Using QtTest library 6\.' <<<"$output" \
    || ! grep -Eq '^Totals: [0-9]+ passed, 0 failed,' <<<"$output" \
    || ! grep -q '^\*\*\*\*\*\*\*\*\* Finished testing of qmltestrunner \*\*\*\*\*\*\*\*\*$' <<<"$output"; then
    printf '%s\n' "qml suite failed: $suite" >&2
    exit 1
  fi
done
PYTHONDONTWRITEBYTECODE=1 python3 tests/test_python_paths.py
PYTHONDONTWRITEBYTECODE=1 python3 tests/test_python_process.py
PYTHONDONTWRITEBYTECODE=1 python3 tests/test_python_inventory.py
PYTHONDONTWRITEBYTECODE=1 python3 tests/test_python_mutations.py
PYTHONDONTWRITEBYTECODE=1 python3 tests/test_extension_image.py
tools/bundle verify
printf '%s\n' 'Rust, QML, companion support and bundled backend checks: ok'
