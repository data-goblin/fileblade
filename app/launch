#!/usr/bin/env bash
set -euo pipefail

launcher=$(readlink -f -- "${BASH_SOURCE[0]}")
app_dir=$(cd -- "$(dirname -- "$launcher")" && pwd -P)
source_dir=$(cd -- "$app_dir/.." && pwd -P)
export FILEBLADE_APP_ROOT=$source_dir
export FILEBLADE_SOURCE_DIR=$source_dir
export FILEBLADE_BINARY=$source_dir/bin/fileblade
export FILEBLADE_NATIVE_STATE_ROOT=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/fileblade

[[ -x $FILEBLADE_BINARY ]] || { printf 'fileblade: native payload backend is unavailable: %s\n' "$FILEBLADE_BINARY" >&2; exit 127; }
if [[ ${1:-} == _backend ]]; then
  shift
  exec "$FILEBLADE_BINARY" native backend -- "$@"
fi
if [[ $# -gt 0 && ! ( $# -eq 2 && $1 == native && $2 == portal ) ]]; then
  exec "$FILEBLADE_BINARY" "$@"
fi
for dependency in qs hyprctl setsid; do
  command -v "$dependency" >/dev/null || { printf 'fileblade: required native capability is unavailable: %s\n' "$dependency" >&2; exit 127; }
done
if ! "$FILEBLADE_BINARY" serve --native-probe >/dev/null 2>&1; then
  export OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
  shell_deadline=$((SECONDS + 30))
  until timeout 2 qs ipc -n -p "$OMARCHY_PATH/shell" call -- shell listPlugins 2>/dev/null | jq -e 'type == "array"' >/dev/null 2>&1; do
    if (( SECONDS >= shell_deadline )); then
      printf '%s\n' 'fileblade: waiting for Omarchy plugin discovery timed out; start FileBlade again after the shell is ready' >&2
      exit 1
    fi
    sleep 0.1
  done
  mkdir -p -- "$FILEBLADE_NATIVE_STATE_ROOT"
  setsid -f "$FILEBLADE_BINARY" serve --native-authority --max-concurrency 16 </dev/null >>"$FILEBLADE_NATIVE_STATE_ROOT/authority.log" 2>&1
  for attempt in {1..100}; do
    "$FILEBLADE_BINARY" serve --native-probe >/dev/null 2>&1 && break
    sleep 0.05
  done
fi
if ! "$FILEBLADE_BINARY" serve --native-probe >/dev/null 2>&1; then
  printf 'fileblade: native authority unavailable; inspect %s\n' "$FILEBLADE_NATIVE_STATE_ROOT/authority.log" >&2
  exit 1
fi
if [[ $# -eq 2 ]]; then
  setsid -f qs -n -p "$app_dir" </dev/null >>"$FILEBLADE_NATIVE_STATE_ROOT/view.log" 2>&1
  for attempt in {1..100}; do
    status=$("$FILEBLADE_BINARY" native ipc -- fileblade.native status 2>/dev/null || true)
    [[ $status == *'"loaded":true'* ]] && exec "$FILEBLADE_BINARY" native portal
    sleep 0.05
  done
  printf 'fileblade: native chooser view unavailable; inspect %s\n' "$FILEBLADE_NATIVE_STATE_ROOT/view.log" >&2
  exit 1
fi
status=$("$FILEBLADE_BINARY" native ipc -- fileblade.native status 2>/dev/null || true)
if [[ $status == *'"loaded":true'* ]]; then
  exec "$FILEBLADE_BINARY" native ipc -- data-goblin.fileblade.control open
fi
export FILEBLADE_ACTIVATE=1
exec qs -n -p "$app_dir"
