#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
notices_mode=${1:-verify}
notices_target=${2:-x86_64-unknown-linux-musl}
notices_output=${3:-THIRD_PARTY_NOTICES.html}
[[ ( $# -le 1 || $# == 3 ) && $notices_mode =~ ^(build|verify)$ ]] || {
  printf '%s\n' 'Usage: tools/notices [build|verify] [TARGET OUTPUT_FILE]' >&2
  exit 2
}
case $notices_target in
  x86_64-unknown-linux-musl|x86_64-unknown-linux-gnu) ;;
  *) printf 'notices: unsupported target: %s\n' "$notices_target" >&2; exit 2 ;;
esac
if [[ $# == 3 && $notices_target != x86_64-unknown-linux-musl && $(realpath -m -- "$notices_output") == "$PWD/THIRD_PARTY_NOTICES.html" ]]; then
  printf '%s\n' 'notices: keep other targets outside the committed notice path' >&2
  exit 2
fi
notices_version=$(sed -n 's/^channel = "\([^"]*\)"$/\1/p' rust-toolchain.toml)
notices_sysroot=$(rustup run "$notices_version" rustc --print sysroot)
notices_work=$(mktemp -d)
trap 'rm -rf -- "$notices_work"' EXIT
notices_args=(metadata --locked --format-version 1 --filter-platform "$notices_target")
[[ ${FILEBLADE_OFFLINE:-0} != 1 ]] || notices_args+=(--offline)
rustup run "$notices_version" cargo "${notices_args[@]}" > "$notices_work/metadata.json"
jq -er '.resolve.nodes | length > 0' "$notices_work/metadata.json" >/dev/null
jq -r '. as $m | [.resolve.nodes[].id] as $ids |
  .packages | sort_by(.name, .version)[] |
  select(.source != null and (.id as $id | $ids | index($id))) |
  [.name, .version, (.license // "See license text"), .manifest_path] | @tsv' \
  "$notices_work/metadata.json" > "$notices_work/packages.tsv"

escape_html() { sed -e 's/\&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

{
  printf '%s\n' '<!doctype html><html lang="en"><meta charset="utf-8">' \
    '<title>FileBlade third-party notices</title>' \
    '<style>body{max-width:78ch;margin:2rem auto;padding:0 1rem}pre{white-space:pre-wrap;overflow-wrap:anywhere}</style>' \
    '<body><h1>FileBlade third-party notices</h1>'
  printf '<p>These are the upstream notices for the locked Rust dependencies selected for %s, followed by the Rust standard-library notices (including musl). Not every listed component is linked into the executable.</p>\n' "$notices_target"
  printf '%s\n' \
    '<p>Dependency sources are unmodified. Each source link downloads the exact crate version from crates.io; Cargo.lock records its checksum. MPL-2.0 source remains available under the Mozilla Public License 2.0. FileBlade itself is covered by LICENSE.</p>'
  while IFS=$'\t' read -r name version license manifest; do
    directory=${manifest%/*}
    printf '<h2>%s %s</h2><p>License: %s. <a href="https://crates.io/api/v1/crates/%s/%s/download">Source archive</a></p>\n' \
      "$name" "$version" "$(printf '%s' "$license" | escape_html)" "$name" "$version"
    mapfile -d '' license_files < <(find "$directory" -maxdepth 2 -type f \
      \( -iname 'license*' -o -iname 'licence*' -o -iname 'copying*' -o -iname 'copyright*' -o -iname 'notice*' \) -print0 | LC_ALL=C sort -z)
    (( ${#license_files[@]} > 0 )) || { printf 'notices: no license text for %s %s\n' "$name" "$version" >&2; exit 1; }
    for license_file in "${license_files[@]}"; do
      printf '<h3>%s</h3><pre>\n' "$(printf '%s' "${license_file#"$directory"/}" | escape_html)"
      escape_html < "$license_file"
      printf '\n</pre>\n'
    done
  done < "$notices_work/packages.tsv"
  printf '<h2>Rust %s standard library and runtime</h2>\n' "$notices_version"
  awk '/<body>/{printing=1;next} /<\/body>/{printing=0} printing' \
    "$notices_sysroot/share/doc/rust/COPYRIGHT-library.html"
  printf '%s\n' '</body></html>'
} | sed 's/[[:blank:]]*$//' > "$notices_work/notices.html"
if [[ $notices_mode == build ]]; then
  install -m 644 "$notices_work/notices.html" "$notices_output"
else
  cmp -- "$notices_work/notices.html" "$notices_output" || {
    printf '%s\n' 'notices: dependency notices changed; run tools/bundle build' >&2
    exit 1
  }
fi
printf '%s\n' 'Third-party notices verified against the locked dependencies and pinned Rust distribution'
