#!/usr/bin/env bash
set -euo pipefail

launcher=$(readlink -f -- "${BASH_SOURCE[0]}")
launcher_dir=$(cd -- "$(dirname -- "$launcher")" && pwd -P)
[[ $(uname -m) == x86_64 ]] || { printf '%s\n' 'fileblade: unsupported architecture' >&2; exit 126; }

candidates=()
if [[ -n ${FILEBLADE_BINARY:-} ]]; then
  candidates+=("$FILEBLADE_BINARY")
fi
candidates+=("$launcher_dir/fileblade-bin")
candidates+=(
  "$launcher_dir/bin/fileblade"
  "$launcher_dir/target/release/fileblade"
  "$launcher_dir/target/debug/fileblade"
  /usr/bin/fileblade-bin
)

for candidate in "${candidates[@]}"; do
  if [[ -f $candidate && -x $candidate && ! $candidate -ef $launcher ]]; then
    exec -- "$candidate" "$@"
  fi
done

printf '%s\n' 'fileblade: no compatible backend found; reinstall the plugin, set FILEBLADE_BINARY, or install a package providing /usr/bin/fileblade-bin' >&2
exit 127
