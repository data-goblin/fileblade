#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
host="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/data-goblin.fileblade/fileblade"
[[ -x $host ]] || host=$(command -v fileblade) || { printf '%s\n' 'FileBlade is not installed; install it, then run these checks again' >&2; exit 127; }
"$host" extension check .
runner=""
for candidate in /usr/lib/qt6/bin/qmltestrunner /usr/lib64/qt6/bin/qmltestrunner qmltestrunner-qt6; do
  if command -v "$candidate" >/dev/null 2>&1; then runner=$(command -v "$candidate"); break; fi
done
[[ -n $runner ]] || { printf '%s\n' 'qmltestrunner not found; install qt6-declarative' >&2; exit 1; }
for suite in tests/tst_*.qml; do
  if output=$(env -u QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM=offscreen QT_STYLE_OVERRIDE=Basic \
    "$runner" -platform offscreen -import tests/imports -input "$suite" 2>&1); then
    status=0
  else
    status=$?
  fi
  printf '%s\n' "$output"
  if ((status != 0)) || ! grep -Eq '^Totals: [0-9]+ passed, 0 failed,' <<<"$output"; then
    printf '%s\n' "qml suite failed: $suite" >&2
    exit 1
  fi
done
linter=""
for candidate in /usr/lib/qt6/bin/qmllint /usr/lib64/qt6/bin/qmllint qmllint-qt6 qmllint; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" --version 2>/dev/null | grep -q ' 6\.'; then linter=$(command -v "$candidate"); break; fi
done
[[ -n $linter ]] || { printf '%s\n' 'Qt 6 qmllint not found; install qt6-declarative' >&2; exit 1; }
mapfile -t qml < <(find . \( -path ./.git -o -path ./tests/imports \) -prune -o -type f \( -name '*.qml' -o -name '*.js' \) -print | sort)
"$linter" --import disable --unqualified disable "${qml[@]}"
printf '%s\n' '{{PLUGIN_ID}} checks: ok'
