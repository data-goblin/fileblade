#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import re
import selectors
import signal
import shutil
import subprocess
import time

HOST_ID = "data-goblin.fileblade"
COMPANIONS = {"{{PLUGIN_ID}}"}
STDOUT_LIMIT = 128 * 1024
STDERR_LIMIT = 4096
ROW_LIMIT = 512
DEADLINE = 2.0


def command_json(arguments: list[str]) -> object:
    process = subprocess.Popen(arguments, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, start_new_session=True)
    deadline = time.monotonic() + DEADLINE
    output = bytearray()
    counts = {"out": 0, "err": 0}
    previous = {}

    def cancelled(signum, frame):
        raise InterruptedError("host check cancelled")

    try:
        for signum in (signal.SIGTERM, signal.SIGINT):
            previous[signum] = signal.signal(signum, cancelled)
        with selectors.DefaultSelector() as streams:
            streams.register(process.stdout, selectors.EVENT_READ, "out")
            streams.register(process.stderr, selectors.EVENT_READ, "err")
            while streams.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError("host check timed out")
                for key, _ in streams.select(remaining):
                    block = os.read(key.fd, 8192)
                    if not block:
                        streams.unregister(key.fileobj)
                        continue
                    counts[key.data] += len(block)
                    limit = STDOUT_LIMIT if key.data == "out" else STDERR_LIMIT
                    if counts[key.data] > limit:
                        raise ValueError("host check exceeded its output limit")
                    if key.data == "out":
                        output.extend(block)
            if process.wait(timeout=max(0.001, deadline - time.monotonic())) != 0:
                raise ValueError("host check failed")
        return json.loads(output)
    finally:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()
        process.stdout.close()
        process.stderr.close()
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def snapshot() -> dict:
    unknown = {"schemaVersion": 1, "state": "unknown", "plugins": []}
    try:
        rows = command_json(["omarchy", "plugin", "list", "--json"])
        if not isinstance(rows, list) or len(rows) > ROW_LIMIT:
            return unknown
        seen = set()
        plugins = []
        host = None
        for row in rows:
            if not isinstance(row, dict):
                return unknown
            identifier = row.get("id")
            if (not isinstance(identifier, str) or len(identifier) > 128
                    or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", identifier)
                    or ".." in identifier or identifier in seen or type(row.get("enabled")) is not bool):
                return unknown
            seen.add(identifier)
            if identifier == HOST_ID:
                host = row
            if identifier in COMPANIONS:
                name = row.get("name")
                plugins.append({"id": identifier, "name": name[:120] if isinstance(name, str) else identifier,
                                "enabled": row["enabled"]})
        result = {"schemaVersion": 1, "state": "missing", "plugins": plugins}
        launcher = shutil.which("fileblade")
        if launcher:
            try:
                status = command_json([launcher, "native", "roles", "status", "--json"])
                if (isinstance(status, dict) and status.get("schema") == 1
                        and status.get("action") == "roles_status" and status.get("error") == ""):
                    result["state"] = "starting"
                    status = command_json([launcher, "native", "ipc", "--", "fileblade.native", "status"])
                    if isinstance(status, dict) and status.get("loaded") is True:
                        result["state"] = "ready"
                    return result
            except (OSError, ValueError, RecursionError, subprocess.TimeoutExpired):
                if result["state"] == "starting":
                    return result
        if host is None:
            return result
        if not host["enabled"]:
            result["state"] = "disabled"
            return result
        result["state"] = "starting"
        try:
            status = command_json(["omarchy-shell", HOST_ID, "status"])
            if isinstance(status, dict) and type(status.get("open")) is bool and isinstance(status.get("rootPath"), str):
                result["state"] = "ready"
        except (OSError, ValueError, RecursionError, subprocess.TimeoutExpired):
            pass
        return result
    except (OSError, ValueError, RecursionError, subprocess.TimeoutExpired):
        return unknown


if __name__ == "__main__":
    print(json.dumps(snapshot(), ensure_ascii=True, separators=(",", ":")))
